{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["./AGENTS.md"],
  "plugin": [
    "opencode-wakatime"
  ],
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?exaApiKey={env:EXA_API_KEY}",
      "enabled": true,
      "oauth": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/{env:FIRECRAWL_API_KEY}/v2/mcp",
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "pencil": {
      "command": [
        "/Applications/Pencil.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
        "--app",
        "desktop",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "tools": {
    // optional: enable/disable Exa tools via glob
    "exa_*": true
  },
  "permission": {
    "read": {
      "$HOME/Documents/MyProject/**": "allow",
      "$HOME/.config/opencode/**": "allow",
      "$HOME/tmp/**": "allow"
    },
    "edit": {
      "$HOME/Documents/MyProject/**": "allow",
      "$HOME/.config/opencode/**": "allow",
      "$HOME/tmp/**": "allow"
    },
    "bash": {
      "cd $HOME/Documents/MyProject*": "allow"
    },
    "external_directory": {
      "$HOME/Documents/MyProject/**": "allow",
      "$HOME/.config/opencode/**": "allow",
      "$HOME/tmp/**": "allow"
    }
  }
}
